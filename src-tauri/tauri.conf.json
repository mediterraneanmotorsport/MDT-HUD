{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDT-HUD",
  "version": "../package.json",
  "identifier": "com.mdthud.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MDT-HUD",
        "backgroundColor": "#09090b",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "decorations": false,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyQUQzN0NFMkFFNzk0QUMKUldTc2xPY3F6amV0QWltZEcwZnlTaXd6aVJ6K3ZjUHdXQXVVcWQyTTdwMDVRRTBic3REb0dNamEK",
      "endpoints": ["https://github.com/mediterraneanmotorsport/MDT-HUD/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "../public/Perfil/**/*"
    ],
    "targets": ["nsis", "appimage", "deb"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
